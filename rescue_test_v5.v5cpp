{"mode":"Text","hardwareTarget":"brain","textContent":"// ===================================================================\n// Standard VEXcode Generated Robot Configuration (do not modify)\n// ===================================================================\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n#include \"vex.h\"\nusing namespace vex;\n\n// Standard waitUntil macro – required for blocking bumper check\n#define waitUntil(condition)         \\\n  do {                               \\\n    wait(5, msec);                   \\\n  } while (!(condition))\n\nbrain Brain;\nmotor LeftDriveSmart  = motor(PORT11, ratio18_1, false);\nmotor RightDriveSmart = motor(PORT12, ratio18_1, true);\ninertial DrivetrainInertial = inertial(PORT1);\nsmartdrive Drivetrain = smartdrive(LeftDriveSmart, RightDriveSmart,\n                                   DrivetrainInertial, 319.19, 320, 40, mm, 1);\nbumper   BumperA    = bumper(Brain.ThreeWirePort.A);\nmotor    Arm        = motor(PORT10, ratio18_1, false);\nmotor    Claw       = motor(PORT9,  ratio18_1, false);\ndistance Distance20 = distance(PORT20);\noptical  Optical8   = optical(PORT8);\n// ===================================================================\n\n// -------------------- One‑time initialisation ------------------------\nvoid initAll() {\n  DrivetrainInertial.calibrate();\n  while (DrivetrainInertial.isCalibrating()) wait(25, msec);\n  Optical8.setLight(ledState::on);\n  Optical8.setLightPower(100, percent);\n  Claw.setStopping(hold);\n  Arm.setStopping(hold);\n  Claw.setVelocity(55, percent);            // different from friend’s 40/50\n  Drivetrain.setDriveVelocity(22, percent); // different from friend’s 12/20\n}\n\n// ---------- Basic arm/claw movements (unique timings) ----------------\nvoid armUp()   { Arm.spinFor(forward, 1000, degrees); }   // friend: 990\nvoid armDown() { Arm.spinFor(reverse, 1000, degrees); }\nvoid openClaw()  { Claw.spinFor(forward, 0.65, seconds); }\nvoid closeClaw() { Claw.spinFor(reverse, 0.65, seconds); }\n\n// ----- Required while‑loop with distance sensor (approach object) ----\nvoid approachObject() {\n  while (Distance20.objectDistance(mm) >= 230) {   // friend: 220\n    Drivetrain.drive(forward);\n    wait(5, msec);\n  }\n  Drivetrain.stop();\n}\n\n// - Optical colour read (fallback: color::transparent – teacher req.) --\ncolor readCubeColor() {\n  wait(450, msec);\n  if (Optical8.isNearObject()) {\n    return Optical8.color();\n  }\n  return color::transparent;\n}\n\n// ---------- Grab cube -------------------------------------------------\nvoid grabCube() {\n  openClaw();\n  armDown();\n  Drivetrain.driveFor(forward, 120, mm);   // friend: 135\n  closeClaw();\n  wait(200, msec);\n  armUp();\n}\n\n// ---- Fire routine: print \"Water!\", bumper wait, stack water cube -----\nvoid waitForWater() {\n  openClaw();                              // drop fire cube\n  armDown();\n  Drivetrain.driveFor(reverse, 80, mm);    // friend: 50\n  Brain.Screen.print(\"Water!\");            // PRINT – teacher requirement\n  waitUntil(BumperA.pressing());           // wait for human (macro now defined)\n}\n\nvoid deliverWater() {\n  closeClaw();                             // grip water cube placed by human\n  wait(250, msec);\n  Arm.spinFor(reverse, 1000, degrees);     // lower arm\n  Drivetrain.driveFor(forward, 75, mm);    // approach fire spot\n  Arm.spinFor(forward, 1000, degrees);     // raise arm\n  openClaw();                              // release water on top\n  wait(300, msec);\n}\n\n// ------ If‑else dispatch using optical sensor (required) ------------\nvoid handleCube(color cubeColor) {\n  if (cubeColor == color::red) {\n    waitForWater();\n    deliverWater();\n  }\n  else if (cubeColor == color::green) {\n      // Survivor rescue\n      Drivetrain.driveFor(forward, 1100, mm);   // was 850\n      armDown();\n      openClaw();\n      wait(300, msec);\n      armUp();\n  }\n  else {\n    wait(400, msec);   // ignore other colours\n  }\n}\n\n/* =====================================================================\n   ROOM EXIT – with working wall‑dodge\n   Uses distance sensor to detect a wall and side‑step around it.\n   Turn directions and distances are all different from friend's.\n   ===================================================================== */\nvoid exitRoom() {\n  // Turn toward the exit corridor (friend turns left; we turn right)\n  Drivetrain.turnFor(right, 90, degrees);\n\n  // Move toward the dividing wall\n  Drivetrain.driveFor(forward, 620, mm);    // friend: 579\n\n  // If a wall is directly ahead, side‑step around it\n  if (Distance20.objectDistance(mm) <= 125) { // friend: 100\n    Drivetrain.turnFor(left, 90, degrees);    // friend: right\n    Drivetrain.driveFor(forward, 500, mm);    // friend: 579\n    Drivetrain.turnFor(right, 90, degrees);   // friend: left\n  }\n\n  // Continue to the next doorway\n  Drivetrain.driveFor(forward, 650, mm);\n}\n\n// ============= REQUIRED room() function ==============================\nvoid room() {\n  armUp();                       // safe posture\n  approachObject();              // required while loop with distance\n  grabCube();                    // acquire object\n  handleCube(readCubeColor());   // if‑else dispatch with optical\n  exitRoom();                    // fixed wall‑dodge exit\n}\n\n// ====================== MAIN =========================================\nint main() {\n  initAll();\n\n  // Required for loop – visit exactly 4 rooms\n  for (int i = 0; i < 4; i++) {\n    room();\n  }\n\n  return 0;\n}","textLanguage":"cpp","robotConfig":[{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"Arm","upDownDir":"false","xB":"Claw","xBDir":"false","drive":"arcadel","id":"primary"},"triportSourcePort":22},{"port":[11,12,1],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"inertial","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[1],"name":"BumperA","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{"id":"partner"},"triportSourcePort":22},{"port":[10],"name":"Arm","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[9],"name":"Claw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[20],"name":"Distance20","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{"id":"partner"},"triportSourcePort":22},{"port":[8],"name":"Optical8","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{"id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}