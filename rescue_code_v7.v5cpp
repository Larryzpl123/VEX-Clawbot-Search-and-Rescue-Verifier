{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n/*============================================================================\n * lar-rescue-2.0\n * SUPER BEUTIFULLY OPTIMIZED CODE\n * VEX Clawbot — Search & Rescue (4 rooms)\n * Modular: every function and every if/else/while body is ≤5 lines.\n *==========================================================================*/\n#include \"vex.h\"\nusing namespace vex;\n\n/*--- Devices ----------------------------------------------------------------*/\nbrain Brain;\nmotor LeftDriveSmart  = motor(PORT11, ratio18_1, false);\nmotor RightDriveSmart = motor(PORT12, ratio18_1, true);\ninertial DrivetrainInertial = inertial(PORT1);\nsmartdrive Drivetrain = smartdrive(LeftDriveSmart, RightDriveSmart,\n                                   DrivetrainInertial, 319.19, 320, 40, mm, 1);\nbumper   BumperA    = bumper(Brain.ThreeWirePort.A);\nmotor    Arm        = motor(PORT10, ratio18_1, false);\nmotor    Claw       = motor(PORT9,  ratio18_1, false);\ndistance Distance20 = distance(PORT20);\noptical  Optical8   = optical(PORT8);\n\n/*--- Macros -----------------------------------------------------------------*/\n// Block until a condition is true; polls every 5ms.\n#define waitUntil(cond) do { wait(5, msec); } while(!(cond))\n\n/*============================================================================\n * SETUP HELPERS\n *==========================================================================*/\n\n// Inertial must finish self-calibrating before any drive command runs.\nvoid calibrate() {\n  DrivetrainInertial.calibrate();\n  while (DrivetrainInertial.isCalibrating()) wait(25, msec);\n}\n\n// Motors hold position when stopped; claw closes gently so cubes don't pop out.\nvoid setupMotors() {\n  Claw.setStopping(hold);   Arm.setStopping(hold);\n  Claw.setVelocity(40, percent);\n  Drivetrain.setDriveVelocity(12, percent);\n}\n\n// CRITICAL: optical light MUST be on, otherwise color reads return junk\n// because the cube sits in the claw's shadow.\nvoid setupOptical() {\n  Optical8.setLight(ledState::on);\n  Optical8.setLightPower(100, percent);\n}\n\n/*============================================================================\n * ARM + CLAW PRIMITIVES\n *==========================================================================*/\n\nvoid armUp()   { Arm.spinFor(forward, 990, degrees); }   // raise claw\nvoid armDown() { Arm.spinFor(reverse, 990, degrees); }   // lower claw\n\n// Close claw until stalled, then keep low torque on it = active grip during carry.\nvoid grip() {\n  Claw.spinFor(reverse, 990, degrees);\n  Claw.spin(reverse, 25, percent);\n}\n\n// Cancel grip torque first (else it fights the open), then open async.\nvoid release() {\n  Claw.stop();\n  Claw.spinFor(forward, 990, degrees, false);\n}\n\n/*============================================================================\n * SENSING & NAVIGATION\n *==========================================================================*/\n\n// Drive forward until distance sensor sees an object within 220mm.\nvoid approachObject() {\n  while (Distance20.objectDistance(mm) >= 220) Drivetrain.drive(forward);\n  Drivetrain.stop();\n}\n\n// Read color via optical, but only when something is actually close enough.\ncolor readCubeColor() {\n  wait(500, msec);                                   // let optical light settle\n  if (Optical8.isNearObject()) return Optical8.color();\n  return color::transparent;\n}\n\n// Acquire cube: open claw, lower arm, drive into cube, close on it.\nvoid grabCube() {\n  release();\n  armDown();\n  Drivetrain.driveFor(forward, 135, mm);\n  grip();\n}\n\n/*============================================================================\n * FIRE BRANCH — stack water (blue) on fire (red)\n *==========================================================================*/\n\n// Drop red cube, back away to door, ask for water, wait for human bumper hit.\nvoid requestWater() {\n  Drivetrain.driveFor(reverse, 50, mm);\n  Brain.Screen.print(\"Water!\");\n  waitUntil(BumperA.pressing());\n}\n\n// Grip the water cube and place it onto the fire.\nvoid deliverWater() {\n  grip();\n  Arm.spinFor(reverse, 990, degrees);\n  Drivetrain.driveFor(forward, 50, mm);\n  Arm.spinFor(forward, 990, degrees);\n  release();\n}\n\nvoid handleFire() {\n  release();\n  requestWater();\n  deliverWater();\n}\n\n/*============================================================================\n * RESCUE BRANCH — carry survivor (green) outside the room\n *==========================================================================*/\n\nvoid handleRescue() {\n  Arm.spinFor(forward, 30, degrees, false);   // tilt arm slightly to stabilize\n  Drivetrain.driveFor(forward, 1158, mm);     // carry across to exit\n  armDown();\n  release();\n}\n\n/*============================================================================\n * COLOR DISPATCH — walled and clear rooms hit neither branch\n *==========================================================================*/\n\nvoid handleCube(color c) {\n  if      (c == red)   handleFire();\n  else if (c == green) handleRescue();\n}\n\n/*============================================================================\n * EXIT ROUTINE\n *==========================================================================*/\n\n// Side-step around the wall: right, forward, left.\nvoid dodgeWall() {\n  Drivetrain.turnFor(right, 90, degrees);\n  Drivetrain.driveFor(forward, 579, mm);\n  Drivetrain.turnFor(left, 90, degrees);\n}\n\n// Standard exit: turn toward door, drive there, dodge if obstructed.\nvoid exitRoom() {\n  Drivetrain.turnFor(left, 90, degrees);\n  Drivetrain.driveFor(forward, 579, mm);\n  if (Distance20.objectDistance(mm) <= 100) dodgeWall();\n}\n\n/*============================================================================\n * ROOM SEQUENCE\n *==========================================================================*/\n\nvoid room() {\n  armUp();\n  approachObject();\n  grabCube();\n  handleCube(readCubeColor());\n  exitRoom();\n}\n\n/*============================================================================\n * MAIN\n *==========================================================================*/\n\nint main() {\n  calibrate();\n  setupMotors();\n  setupOptical();\n  for (int i = 0; i < 4; i++) room();\n}","textLanguage":"cpp","robotConfig":[{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"Arm","upDownDir":"false","xB":"Claw","xBDir":"false","drive":"arcadel","id":"primary"},"triportSourcePort":22},{"port":[11,12,1],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"inertial","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[1],"name":"BumperA","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{"id":"partner"},"triportSourcePort":22},{"port":[10],"name":"Arm","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[9],"name":"Claw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[20],"name":"Distance20","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{"id":"partner"},"triportSourcePort":22},{"port":[8],"name":"Optical8","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{"id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}
